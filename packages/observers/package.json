{
	"name": "@rooted/observers",
	"version": "1.0.0-alpha.0",
	"description": "DOM observers that clean up with an AbortSignal",
	"keywords": [
		"web-components",
		"intersection-observer",
		"mutation-observer",
		"resize-observer",
		"typescript",
		"rooted"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Marvin-Brouwer/rooted.git",
		"directory": "packages/observers"
	},
	"homepage": "https://github.com/Marvin-Brouwer/rooted#readme",
	"bugs": "https://github.com/Marvin-Brouwer/rooted/issues",
	"sideEffects": false,
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist",
		"readme.md"
	],
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"exports": {
		".": {
			"import": "./dist/observers.mjs",
			"types": "./dist/observers.d.mjs"
		}
	},
	"scripts": {
		"build": "pnpm build:ci",
		"build:dev": "pnpm build:ci && rooted-development extract-api",
		"build:ci": "tsdown",
		"watch": "tsdown --watch --no-clean",
		"clean": "rm -rf dist",
		"extract-api": "rooted-development extract-api"
	},
	"devDependencies": {
		"@rooted/development": "workspace:*",
		"tsx": "^4.23.13"
	}
}
