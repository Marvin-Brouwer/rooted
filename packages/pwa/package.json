{
	"name": "@rooted/pwa",
	"version": "1.0.0-alpha.0",
	"description": "Service worker registration and update components for the rooted framework",
	"keywords": [
		"web-components",
		"pwa",
		"service-worker",
		"typescript",
		"rooted"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Marvin-Brouwer/rooted.git",
		"directory": "packages/pwa"
	},
	"homepage": "https://github.com/Marvin-Brouwer/rooted#readme",
	"bugs": "https://github.com/Marvin-Brouwer/rooted/issues",
	"sideEffects": false,
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist",
		"readme.md"
	],
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"exports": {
		".": {
			"source": "./src/_module/pwa.mts",
			"import": "./dist/pwa.mjs",
			"types": "./dist/pwa.d.mts"
		},
		"./components": {
			"source": "./src/_module/components.mts",
			"import": "./dist/components.mjs",
			"types": "./dist/components.d.mts"
		}
	},
	"peerDependencies": {
		"@rooted/components": "workspace:^"
	},
	"scripts": {
		"build": "pnpm build:ci",
		"build:dev": "pnpm build:ci && rooted-development extract-api",
		"build:ci": "tsdown",
		"watch": "tsdown --watch --no-clean",
		"clean": "rm -rf dist",
		"extract-api": "rooted-development extract-api"
	},
	"devDependencies": {
		"@rooted/components": "workspace:^",
		"@rooted/development": "workspace:*",
		"tsx": "^4.23.13"
	}
}
