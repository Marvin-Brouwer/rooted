{
	"name": "@rooted/prerender",
	"version": "1.0.0-alpha.0",
	"description": "Build-time pre-rendering of a built rooted app in happy-dom",
	"keywords": [
		"prerender",
		"ssg",
		"typescript",
		"rooted"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Marvin-Brouwer/rooted.git",
		"directory": "packages/prerender"
	},
	"homepage": "https://github.com/Marvin-Brouwer/rooted#readme",
	"bugs": "https://github.com/Marvin-Brouwer/rooted/issues",
	"sideEffects": false,
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist",
		"readme.md"
	],
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"exports": {
		".": {
			"source": "./src/_module/prerender.mts",
			"import": "./dist/prerender.mjs",
			"types": "./dist/prerender.d.mts"
		}
	},
	"scripts": {
		"build": "pnpm build:ci",
		"build:dev": "pnpm build:ci && rooted-development extract-api",
		"build:ci": "tsdown",
		"watch": "tsdown --watch --no-clean",
		"clean": "rm -rf dist",
		"extract-api": "rooted-development extract-api"
	},
	"dependencies": {
		"@rooted/dom-globals": "workspace:^",
		"happy-dom": "^20.14.5"
	},
	"devDependencies": {
		"@rooted/development": "workspace:*",
		"@types/node": "^26.6.1",
		"tsx": "^4.23.13"
	}
}
