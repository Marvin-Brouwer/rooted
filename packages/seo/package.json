{
	"name": "@rooted/seo",
	"version": "1.0.0-alpha.0",
	"description": "Build-time SEO for the rooted framework",
	"keywords": [
		"seo",
		"sitemap",
		"robots-txt",
		"llms-txt",
		"vite",
		"rooted"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Marvin-Brouwer/rooted.git",
		"directory": "packages/seo"
	},
	"homepage": "https://github.com/Marvin-Brouwer/rooted#readme",
	"bugs": "https://github.com/Marvin-Brouwer/rooted/issues",
	"sideEffects": false,
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist",
		"readme.md"
	],
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"exports": {
		".": {
			"source": "./plugins/_module/seo.mts",
			"import": "./dist/seo.mjs",
			"types": "./dist/seo.d.mts"
		},
		"./router": {
			"source": "./plugins/_module/router.mts",
			"import": "./dist/router.mjs",
			"types": "./dist/router.d.mts"
		}
	},
	"scripts": {
		"build": "pnpm build:ci",
		"build:dev": "pnpm build:ci && rooted-development extract-api",
		"build:ci": "tsdown",
		"watch": "tsdown --watch --no-clean",
		"clean": "rm -rf dist",
		"extract-api": "rooted-development extract-api"
	},
	"peerDependencies": {
		"@rooted/router": "workspace:^",
		"vite": ">=8.0.1",
		"vite-plugin-pwa": ">= 1.2.0"
	},
	"peerDependenciesMeta": {
		"@rooted/router": {
			"optional": true
		}
	},
	"dependencies": {
		"tinyglobby": "^0.2.17",
		"vite-plugin-pwa": "^1.3.0"
	},
	"devDependencies": {
		"@rooted/development": "workspace:*",
		"@rooted/router": "workspace:^",
		"@types/node": "^26.2.0",
		"vite": "^8.2.2"
	}
}
