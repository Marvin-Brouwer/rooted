import { codeBlock } from './code-block.mts'
import { colours, paletteCss } from './palette.mts'
import { wordmark } from './wordmark.mts'

/** GitHub's recommended social preview size. */
export const socialCardSize = { width: 1280, height: 640 }

const margin = 56
const codeSize = 22
const lineHeight = 1.45
const wordmarkWidth = 560

/**
 * The GitHub social preview: code in the top-left, the wordmark in the bottom-right.
 * No dark mode, social previews are shown as plain images.
 */
export function socialCard() {
	const { width, height } = socialCardSize
	const code = codeBlock({ x: margin, y: margin + codeSize, size: codeSize, lineHeight })
	const mark = wordmark(wordmarkWidth)
	const corner = `translate(${width - margin - mark.width} ${Number((height - margin - mark.height).toFixed(2))})`

	return [
		`<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" role="img" aria-label="rooted">`,
		'<!-- Generated by `pnpm branding banners`, edit tooling/branding instead. -->',
		'<title>rooted</title>',
		`<style>${paletteCss(false)}</style>`,
		`<defs>${code.definitions}</defs>`,
		`<rect width="${width}" height="${height}" fill="${colours.green}"/>`,
		code.markup,
		`<g transform="${corner}">${mark.markup}</g>`,
		'</svg>',
		'',
	].join('\n')
}
