import { logoTile } from './logo-tile.mts'
import { colours, paletteCss } from './palette.mts'
import { wordmark } from './wordmark.mts'

/** Width of the `viewBox`. The banner scales, so this only sets the precision of the numbers. */
const width = 1000

/**
 * The README banner for narrow screens: the wordmark on a green field, in the proportions of the logo tile.
 *
 * Unlike `banner.svg` it has a `viewBox`, so it has a fixed shape and scales like any other image.
 * That's what viewers need that size an image by its proportions, like the GitHub mobile app.
 * The README picks it with `<picture>` below 760 px.
 *
 * The background runs far past the `viewBox`.
 * When a viewer gives the image a different shape anyway (the README sets a height for the wide banner, and the `<img>` keeps it), the green fills the whole box and the wordmark stays in the bottom-right corner.
 */
export function bannerNarrow() {
	const mark = wordmark(width * logoTile.width)
	const right = width * logoTile.right
	const bottom = width * logoTile.bottom
	const height = Number((bottom + mark.height + bottom).toFixed(2))
	const corner = `translate(${width - right - mark.width} ${Number((height - bottom - mark.height).toFixed(2))})`

	return [
		`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" preserveAspectRatio="xMaxYMax meet" role="img" aria-label="rooted">`,
		'<!-- Generated by `pnpm branding banners`, edit tooling/branding instead. -->',
		'<title>rooted</title>',
		`<style>${paletteCss(true)}</style>`,
		`<rect x="${-width * 10}" y="${-width * 10}" width="${width * 21}" height="${width * 21}" fill="${colours.green}"/>`,
		`<g transform="${corner}">${mark.markup}</g>`,
		'</svg>',
		'',
	].join('\n')
}
