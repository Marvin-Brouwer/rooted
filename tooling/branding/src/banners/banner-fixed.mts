import { bannerLayout } from './banner-layout.mts'
import { codeBlock } from './code-block.mts'
import { colours, paletteCss } from './palette.mts'
import { wordmark } from './wordmark.mts'

/** The width the desktop layout is drawn at. Wide enough for the code and the wordmark side by side. */
const width = 900

/**
 * The desktop banner at a fixed size of 900 × 340, for medium screens.
 *
 * Same layout as `banner.svg`, but with a `viewBox`, so it scales like any other image instead of stretching.
 * That's what viewers need that size an image by its proportions, like the GitHub mobile app in landscape.
 * The README picks it with `<picture>` between 600 and 1011 px.
 *
 * Like `banner-narrow.svg`, the background runs far past the `viewBox`.
 * In a box of a different shape the green fills it and the content stays centred.
 */
export function bannerFixed() {
	const { height, margin, codeSize, lineHeight, wordmarkWidth } = bannerLayout
	const code = codeBlock({ x: margin, y: margin + codeSize, size: codeSize, lineHeight })
	const mark = wordmark(wordmarkWidth)
	const corner = `translate(${width - margin - mark.width} ${Number((height - margin - mark.height).toFixed(2))})`

	return [
		`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="rooted">`,
		'<!-- Generated by `pnpm branding banners`, edit tooling/branding instead. -->',
		'<title>rooted</title>',
		`<style>${paletteCss(true)}</style>`,
		`<defs>${code.definitions}</defs>`,
		`<rect x="${-width * 10}" y="${-height * 10}" width="${width * 21}" height="${height * 21}" fill="${colours.green}"/>`,
		code.markup,
		`<g transform="${corner}">${mark.markup}</g>`,
		'</svg>',
		'',
	].join('\n')
}
